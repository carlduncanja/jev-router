#!/usr/bin/env python3
"""Codex App Server proxy backed by Jev Router SaaS."""

from __future__ import annotations

import getpass
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import threading
import time
import urllib.request


REAL_CODEX = os.environ.get("JEV_ROUTER_REAL_CODEX", "/Applications/ChatGPT.app/Contents/Resources/codex")
CONFIG_PATH = Path.home() / ".codex" / "jev-router-saas.json"
SETTINGS_PATH = Path.home() / ".codex" / "jev-router-settings.json"
LOG_PATH = Path.home() / ".codex" / "log" / "jev-router-saas.log"
MODELS = {
    "gpt-6-astra": "GPT-6 Astra",
    "gpt-5.6-sol": "GPT-5.6 Sol",
    "gpt-5.6-terra": "GPT-5.6 Terra",
    "gpt-5.6-luna": "GPT-5.6 Luna",
}
EFFORTS = {"low", "medium", "high", "xhigh", "max"}
MAX_PROMPT_CHARS = 6000
STDOUT_LOCK = threading.Lock()
PENDING_LOCK = threading.Lock()
PENDING_REQUESTS: dict[str, tuple[str, str, str]] = {}
PENDING_TURNS: dict[str, tuple[str, str, str]] = {}
SECRET_PATTERNS = (
    re.compile(r"(?i)\b(apikey|api[_ -]?key|token|password|secret)\s*[:=]\s*[^\s,;]+"),
    re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{12,}"),
    re.compile(r"\b(?:sk|apikey)_[A-Za-z0-9_-]{16,}\b"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S),
)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def log(message: str) -> None:
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as handle:
            handle.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + message + "\n")
        os.chmod(LOG_PATH, 0o600)
    except OSError:
        pass


def config() -> dict:
    try:
        value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def configured_choices() -> tuple[tuple[str, ...], tuple[str, ...]]:
    models = tuple(MODELS)
    efforts = ("low", "medium", "high", "xhigh", "max")
    try:
        saved = json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
        if not isinstance(saved, dict):
            return models, efforts
        selected_models = tuple(model for model in models if model in saved.get("models", []))
        selected_efforts = tuple(effort for effort in efforts if effort in saved.get("efforts", []))
        return selected_models or models, selected_efforts or efforts
    except (OSError, json.JSONDecodeError):
        return models, efforts


def fallback_model(allowed: tuple[str, ...], current: str | None) -> str:
    return current if current in allowed else ("gpt-6-astra" if "gpt-6-astra" in allowed else allowed[0])


def fallback_effort(allowed: tuple[str, ...], current: str | None) -> str:
    return current if current in allowed else ("medium" if "medium" in allowed else allowed[0])


def endpoint() -> str:
    value = os.environ.get("JEV_ROUTER_SAAS_URL", "").strip() or str(config().get("endpoint", "")).strip()
    if not (value.startswith("https://") or value.startswith("http://127.0.0.1:") or value.startswith("http://localhost:")):
        raise RuntimeError("SaaS endpoint must use HTTPS")
    return value


def token() -> str:
    value = os.environ.get("JEV_ROUTER_SAAS_TOKEN", "").strip()
    if value:
        return value
    result = subprocess.run(
        ["/usr/bin/security", "find-generic-password", "-a", getpass.getuser(), "-s", "jev-router-saas", "-w"],
        capture_output=True,
        text=True,
        timeout=3,
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise RuntimeError("SaaS token unavailable")
    return result.stdout.strip()


def redact(text: str) -> str:
    value = text[:MAX_PROMPT_CHARS]
    for pattern in SECRET_PATTERNS:
        value = pattern.sub("[REDACTED_CREDENTIAL]", value)
    return value


def prompt_text(params: dict) -> str:
    return "\n".join(
        item["text"]
        for item in params.get("input") or []
        if isinstance(item, dict)
        and item.get("type") in {"text", "inputText"}
        and isinstance(item.get("text"), str)
    ).strip()


def forced_effort(prompt: str) -> str | None:
    for effort in ("max", "xhigh", "high", "medium", "low"):
        if re.search(rf"(?i)(?:\[{effort}\]|/{effort}\b|\breasoning\s*[:=]\s*{effort}\b)", prompt):
            return effort
    return None


def forced_model(prompt: str) -> str | None:
    for short, model in (("astra", "gpt-6-astra"), ("sol", "gpt-5.6-sol"), ("terra", "gpt-5.6-terra"), ("luna", "gpt-5.6-luna")):
        if re.search(rf"(?i)(?:\[{short}\]|/{short}\b|\bmodel\s*[:=]\s*(?:gpt-[0-9.]+-)?{short}\b)", prompt):
            return model
    return None


def route(prompt: str, current_model: str | None, current_effort: str | None) -> tuple[str, str, str]:
    allowed_models, allowed_efforts = configured_choices()
    model_override = forced_model(prompt)
    effort_override = forced_effort(prompt)
    if model_override not in allowed_models:
        model_override = None
    if effort_override not in allowed_efforts:
        effort_override = None
    if re.search(r"(?i)(?:\[no-jev\]|/no-jev\b)", prompt):
        return fallback_model(allowed_models, current_model), fallback_effort(allowed_efforts, current_effort), "bypass"
    if model_override and effort_override:
        return model_override, effort_override, "explicit"
    body = json.dumps(
        {"prompt": redact(prompt), "current_model": current_model, "current_effort": current_effort,
         "allowed_models": list(allowed_models), "allowed_efforts": list(allowed_efforts)},
        separators=(",", ":"),
    ).encode()
    request = urllib.request.Request(
        endpoint(),
        data=body,
        headers={"Authorization": "Bearer " + token(), "Content-Type": "application/json"},
    )
    with urllib.request.build_opener(NoRedirect).open(request, timeout=5) as response:
        result = json.load(response)
    model = result.get("model")
    effort = result.get("effort")
    if model not in allowed_models or effort not in allowed_efforts:
        raise ValueError("Invalid SaaS route")
    return model_override or model, effort_override or effort, "saas-explicit" if model_override or effort_override else "saas"


def request_key(message: dict) -> str | None:
    if "id" not in message:
        return None
    try:
        return json.dumps(message["id"], sort_keys=True, separators=(",", ":"))
    except (TypeError, ValueError):
        return None


def rewrite(line: bytes) -> bytes:
    try:
        message = json.loads(line)
        if not isinstance(message, dict) or message.get("method") != "turn/start":
            return line
        params = message.get("params")
        if not isinstance(params, dict) or params.get("toolOutput") is not None:
            return line
        prompt = prompt_text(params)
        if not prompt:
            return line
        old_model = params.get("model") if isinstance(params.get("model"), str) else None
        old_effort = params.get("effort") if isinstance(params.get("effort"), str) else None
        try:
            model, effort, source = route(prompt, old_model, old_effort)
        except Exception as error:
            allowed_models, allowed_efforts = configured_choices()
            model = forced_model(prompt)
            effort = forced_effort(prompt)
            model = model if model in allowed_models else fallback_model(allowed_models, old_model)
            effort = effort if effort in allowed_efforts else fallback_effort(allowed_efforts, old_effort)
            source = "fallback"
            log(f"routing_error={type(error).__name__}")
        params["model"] = model
        params["effort"] = effort
        collaboration = params.get("collaborationMode")
        if isinstance(collaboration, dict) and isinstance(collaboration.get("settings"), dict):
            collaboration["settings"]["model"] = model
            collaboration["settings"]["reasoning_effort"] = effort
        key = request_key(message)
        thread_id = params.get("threadId")
        if key is not None and isinstance(thread_id, str):
            with PENDING_LOCK:
                PENDING_REQUESTS[key] = (thread_id, model, effort)
        log(f"model={model} effort={effort} source={source} chars={len(prompt)}")
        return (json.dumps(message, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
        return line


def write_client(data: bytes) -> None:
    try:
        with STDOUT_LOCK:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
    except (BrokenPipeError, OSError):
        pass


def write_notice(thread_id: str, turn_id: str, model: str, effort: str) -> None:
    item = {
        "id": f"jev_route_{turn_id}",
        "type": "agentMessage",
        "text": f"{MODELS[model]} with {effort.title()} reasoning for this turn.",
        "phase": "commentary",
    }
    for method in ("item/started", "item/completed"):
        write_client((json.dumps({"method": method, "params": {"threadId": thread_id, "turnId": turn_id, "item": item}}, separators=(",", ":")) + "\n").encode())


def copy_stdout(source) -> None:
    try:
        for line in source:
            write_client(line)
            try:
                message = json.loads(line)
                if not isinstance(message, dict):
                    continue
                if message.get("method") == "turn/started":
                    params = message.get("params")
                    turn = params.get("turn") if isinstance(params, dict) else None
                    turn_id = turn.get("id") if isinstance(turn, dict) else None
                    if isinstance(turn_id, str) and (pending := PENDING_TURNS.pop(turn_id, None)):
                        thread_id, model, effort = pending
                        write_notice(thread_id, turn_id, model, effort)
                    continue
                key = request_key(message)
                if key is None:
                    continue
                with PENDING_LOCK:
                    pending = PENDING_REQUESTS.pop(key, None)
                if pending is None or "result" not in message:
                    continue
                result = message.get("result")
                turn = result.get("turn") if isinstance(result, dict) else None
                turn_id = turn.get("id") if isinstance(turn, dict) else None
                if isinstance(turn_id, str):
                    PENDING_TURNS[turn_id] = pending
            except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
                continue
    except (BrokenPipeError, OSError):
        pass


def copy_stream(source, destination) -> None:
    try:
        while chunk := source.read(65536):
            destination.write(chunk)
            destination.flush()
    except (BrokenPipeError, OSError):
        pass


def proxy(args: list[str]) -> int:
    child_env = os.environ.copy()
    child_env.pop("CODEX_CLI_PATH", None)
    process = subprocess.Popen(
        [REAL_CODEX, *args], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=child_env, bufsize=0
    )
    threads = [
        threading.Thread(target=copy_stdout, args=(process.stdout,), daemon=True),
        threading.Thread(target=copy_stream, args=(process.stderr, sys.stderr.buffer), daemon=True),
    ]
    for thread in threads:
        thread.start()
    try:
        for line in sys.stdin.buffer:
            process.stdin.write(rewrite(line))
            process.stdin.flush()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        try:
            process.stdin.close()
        except (BrokenPipeError, OSError):
            pass
    code = process.wait()
    for thread in threads:
        thread.join(timeout=1)
    return code


def main() -> int:
    args = sys.argv[1:]
    if "app-server" not in args:
        os.execve(REAL_CODEX, [REAL_CODEX, *args], {key: value for key, value in os.environ.items() if key != "CODEX_CLI_PATH"})
    return proxy(args)


if __name__ == "__main__":
    raise SystemExit(main())
